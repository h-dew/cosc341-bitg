<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_background">

    <!-- Toolbar — matches inbox/conversation style -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/md_theme_surfaceContainerHigh"
        android:paddingBottom="16dp"
        android:elevation="4dp">

        <!-- Status bar spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="36dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/back"
                android:padding="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/md_theme_onSurface"/>

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Profile"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_onSurface"
                android:layout_marginStart="4dp"/>

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Profile photo -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="240dp"
                app:cardCornerRadius="16dp"
                app:cardBackgroundColor="@color/md_theme_primaryContainer"
                app:strokeWidth="0dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="👤"
                    android:textSize="80sp"/>

            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/tvProfileName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Name, Age"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/md_theme_onBackground"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvProfileLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Location"
                android:textSize="18sp"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvProfileInterests"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Interests"
                android:textSize="18sp"
                android:textColor="@color/md_theme_onSurface"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvProfileBio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bio"
                android:textSize="17sp"
                android:lineSpacingMultiplier="1.3"
                android:textColor="@color/md_theme_onSurfaceVariant"
                android:layout_marginBottom="36dp"/>

            <!-- Connect / Pass -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnConnect"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="Connect"
                    android:textSize="18sp"
                    app:icon="@drawable/ic_check"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:backgroundTint="@color/md_theme_tertiaryContainer"
                    android:layout_marginEnd="10dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPass"
                    android:layout_width="0dp"
                    android:layout_height="64dp"
                    android:layout_weight="1"
                    android:text="Pass"
                    android:textSize="18sp"
                    app:icon="@drawable/ic_close"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:backgroundTint="@color/md_theme_secondaryContainer"/>

            </LinearLayout>

            <!-- Report / Block -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReport"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Report"
                    android:textSize="16sp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_marginEnd="10dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBlock"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Block"
                    android:textSize="16sp"
                    style="@style/Widget.Material3.Button.OutlinedButton"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>
