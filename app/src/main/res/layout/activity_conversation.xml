<?xml version="1.0" encoding="utf-8"?>
<!--
    windowSoftInputMode="adjustResize" in the manifest entry for this
    activity is what makes the compose bar rise above the keyboard.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/md_theme_background">

    <!-- Toolbar -->
    <LinearLayout
        android:id="@+id/convToolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/md_theme_surfaceContainerHigh"
        android:elevation="4dp">

        <!-- Status bar spacer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="36dp"/>

        <!-- Back button + contact name row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="4dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp">

            <!-- Back button — generous 56dp touch target -->
            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:src="@drawable/back"
                android:padding="14dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/md_theme_onSurface"/>

            <!-- Avatar circle — larger for legibility -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="52dp"
                android:layout_height="52dp"
                app:cardCornerRadius="26dp"
                app:cardBackgroundColor="@color/md_theme_primaryContainer"
                app:strokeWidth="0dp"
                app:cardElevation="0dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="14dp">

                <TextView
                    android:id="@+id/tvConvAvatar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onPrimaryContainer"/>

            </com.google.android.material.card.MaterialCardView>

            <!-- Name + status -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvConvName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/md_theme_onSurface"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active now"
                    android:textSize="14sp"
                    android:textColor="@color/md_theme_primary"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"/>

    <!-- Message list -->
    <ListView
        android:id="@+id/listViewMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:clipToPadding="false"
        android:transcriptMode="alwaysScroll"
        android:stackFromBottom="true"/>

    <!-- Compose bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp"
        android:gravity="center_vertical"
        android:background="@color/md_theme_surfaceContainerLow">

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:hint="Type a message"
            app:hintTextAppearance="@style/TextAppearance.Material3.BodyLarge"
            app:boxCornerRadiusTopStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusBottomEnd="28dp"
            android:layout_marginEnd="12dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMessageInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:paddingVertical="14dp"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLines="4"
                android:imeOptions="actionSend"/>

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Send button — 60dp for an easy tap target -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            android:layout_width="60dp"
            android:layout_height="60dp"
            app:icon="@drawable/ic_send"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="28dp"
            android:paddingLeft="0dp"
            android:paddingRight="0dp"
            style="@style/Widget.Material3.Button"
            app:cornerRadius="30dp"/>

    </LinearLayout>

</LinearLayout>
