<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/md_theme_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step 2 of 3"
        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
        android:layout_marginTop="24dp"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="66"
        app:trackThickness="6dp"
        app:trackCornerRadius="3dp"
        app:indicatorColor="@color/md_theme_primary"
        app:trackColor="@color/md_theme_surfaceVariant"
        android:layout_marginBottom="28dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Your Interests"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textColor="@color/md_theme_onBackground"
        android:layout_marginBottom="24dp"/>

    <!-- Row 1 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <CheckBox
            android:id="@+id/cbMusic"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="🎵  Music"
            android:button="@null"
            android:background="@drawable/interest_checkbox_bg"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:padding="12dp"
            android:layout_marginEnd="8dp"/>

        <CheckBox
            android:id="@+id/cbReading"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="📚  Reading"
            android:button="@null"
            android:background="@drawable/interest_checkbox_bg"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:padding="12dp"/>

    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <CheckBox
            android:id="@+id/cbWalking"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="🚶  Walking"
            android:button="@null"
            android:background="@drawable/interest_checkbox_bg"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:padding="12dp"
            android:layout_marginEnd="8dp"/>

        <CheckBox
            android:id="@+id/cbCooking"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="🍳  Cooking"
            android:button="@null"
            android:background="@drawable/interest_checkbox_bg"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:padding="12dp"/>

    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="32dp">

        <CheckBox
            android:id="@+id/cbGardening"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="🌱  Gardening"
            android:button="@null"
            android:background="@drawable/interest_checkbox_bg"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:padding="12dp"
            android:layout_marginEnd="8dp"/>

        <CheckBox
            android:id="@+id/cbTravel"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:text="✈️  Travel"
            android:button="@null"
            android:background="@drawable/interest_checkbox_bg"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:padding="12dp"/>

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext2"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Next"
        android:textSize="16sp"
        style="@style/Widget.Material3.Button"/>

</LinearLayout>
