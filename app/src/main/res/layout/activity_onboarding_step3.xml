<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/md_theme_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Step 3 of 3"
        android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
        android:layout_marginTop="24dp"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="100"
        app:trackThickness="6dp"
        app:trackCornerRadius="3dp"
        app:indicatorColor="@color/md_theme_primary"
        app:trackColor="@color/md_theme_surfaceVariant"
        android:layout_marginBottom="28dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Matching Preference"
        android:textAppearance="@style/TextAppearance.Material3.HeadlineSmall"
        android:textColor="@color/md_theme_onBackground"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Match me by:"
        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
        android:textColor="@color/md_theme_onSurfaceVariant"
        android:layout_marginBottom="24dp"/>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:strokeWidth="0dp"
        app:cardElevation="0dp"
        android:layout_marginBottom="32dp">

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbInterests"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Interests"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:paddingVertical="16dp"
                android:paddingHorizontal="20dp"/>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"/>

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:paddingVertical="16dp"
                android:paddingHorizontal="20dp"/>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"/>

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/rbBoth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Both"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:paddingVertical="16dp"
                android:paddingHorizontal="20dp"/>

        </RadioGroup>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinish"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Finish"
        android:textSize="16sp"
        style="@style/Widget.Material3.Button"/>

</LinearLayout>
