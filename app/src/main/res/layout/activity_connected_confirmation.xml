<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#FFFFFF">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="✓"
        android:textSize="64sp"
        android:textColor="#4CAF50"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:id="@+id/tvConfirmMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Request sent!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        android:gravity="center"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tvConfirmSub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="She will be notified."
        android:textSize="16sp"
        android:textColor="#888888"
        android:gravity="center"
        android:layout_marginBottom="40dp"/>

    <Button
        android:id="@+id/btnBackToMatches"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Back to Matches"
        android:backgroundTint="#E91E8C"/>

</LinearLayout>